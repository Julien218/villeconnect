{
  "expo": {
    "name": "Ma Commune",
    "slug": "macommune",
    "owner": "js-innov.ia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "macommune",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "be.jsinnovaia.macommune",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0F1E"
      },
      "package": "be.jsinnovaia.macommune"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9945412e-d2d1-490b-a583-d7568cddd47d"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0F1E"
        }
      ],
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Autorisez Ma Commune à utiliser votre position pour trouver les stations-service et comparer leurs prix autour de vous.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorisez Ma Commune à accéder à vos photos pour illustrer les produits de votre commerce.",
          "cameraPermission": "Autorisez Ma Commune à utiliser l’appareil photo pour photographier les produits de votre commerce.",
          "microphonePermission": false
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/9945412e-d2d1-490b-a583-d7568cddd47d"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
