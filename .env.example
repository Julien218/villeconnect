# ─── VilleConnect — Environment Variables ────────────────────────────────────
# Copier ce fichier en .env et remplir les valeurs

# ── Base de données MySQL ─────────────────────────────────────────────────────
# Format : mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://villeconnect:YOUR_PASSWORD@localhost:3306/villeconnect_db

# ── Auth / Session ────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
OWNER_OPEN_ID=your-owner-open-id

# ── OAuth (Manus platform) ────────────────────────────────────────────────────
OAUTH_SERVER_URL=https://auth.manus.space
VITE_APP_ID=your-app-id

# ── Push Notifications (Expo) ─────────────────────────────────────────────────
# Aucune clé requise pour Expo Push — les tokens sont enregistrés via l'app

# ── Optionnel : Email (confirmation événements) ───────────────────────────────
# SENDGRID_API_KEY=SG.xxxx
# SMTP_FROM=noreply@villeconnect.be

# ── Expo Public (frontend) ────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ID=your-app-id
EXPO_PUBLIC_OAUTH_SERVER_URL=https://auth.manus.space
