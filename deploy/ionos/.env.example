# Copier en .env sur le serveur (jamais dans le dépôt) : cp .env.example .env && chmod 600 .env

# ─── Serveur ───
API_DOMAIN=api.villeconnectos.com
ACME_EMAIL=contact@villeconnectos.com

# ─── MySQL (générer avec : openssl rand -hex 24) ───
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ─── API : reprendre les valeurs actuelles du service Railway « villeconnect » ───
# Garder le MÊME JWT_SECRET et le MÊME CITY_HASH_SALT que Railway, sinon les citoyens
# sont déconnectés et les empreintes de confidentialité ne correspondent plus.
JWT_SECRET=
CITY_HASH_SALT=
CORS_ORIGINS=https://villeconnectos.com,https://www.villeconnectos.com,https://app.villeconnectos.com
WEB_APP_URL=https://app.villeconnectos.com
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=5
MIN_ORDER_CENTS=1000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
