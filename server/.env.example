# VilleConnect OS API — exemple sans secret réel
NODE_ENV=development
PORT=3000

# MySQL 8
DATABASE_URL=mysql://villeconnect:change_me@127.0.0.1:3306/villeconnect

# 32 caractères aléatoires minimum. Utiliser une valeur différente par environnement.
JWT_SECRET=change_me_with_at_least_32_random_characters

# Secret HMAC propre aux QR CivicLoop, distinct du JWT_SECRET.
WALLET_QR_SECRET=change_me_with_a_distinct_32_char_secret

# Origines web autorisées, séparées par des virgules. Les apps natives n’envoient pas Origin.
CORS_ORIGINS=http://localhost:8081,https://villeconnectos.com,https://app.villeconnectos.com

# Services optionnels
RESEND_API_KEY=
CITY_HASH_SALT=change_me_with_a_random_city_hash_salt

# ─── Paiement en ligne (Stripe Connect) — optionnel tant que les commandes ne sont pas ouvertes ───
# Clé secrète Stripe (sk_test_... en test, sk_live_... en production). JAMAIS dans le dépôt ni dans l'app.
STRIPE_SECRET_KEY=
# Secret du webhook Connect (whsec_...). Point d'entrée : POST /webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Adresse publique de l'application web, utilisée pour les retours de paiement et les liens Stripe.
WEB_APP_URL=http://localhost:8081
# Commission de la plateforme en % (défaut 5) et commande minimale en centimes (défaut 1000 = 10 €).
PLATFORM_FEE_PERCENT=5
MIN_ORDER_CENTS=1000

# Import automatique des flux d'événements iCal (toutes les 6 h). 1 = activé. Voir README.
EVENT_FEED_SYNC=0

# Pré-modération des annonces par IA (API Anthropic). Désactivée par défaut.
COMMUNITY_AI=0
ANTHROPIC_API_KEY=
COMMUNITY_AI_MODEL=claude-haiku-5-5
# 1 = l’IA peut publier directement les annonces jugées conformes (sinon : seulement les auteurs de confiance)
COMMUNITY_AI_AUTOPUBLISH=0
